# Database
DATABASE_URL=

# Geo: Google Maps Platform
# Single key authorizes Geocoding API + Places API (New). Restrict in
# Cloud Console to those APIs and to the IPs of the Trigger worker
# deployment. Consumed by tracking-event coordinate resolution when the
# geocoder factory is configured to use the "google" adapter.
GOOGLE_MAPS_API_KEY=

# Geo: Rollo (legacy Google Places via Rollo's iOS app credentials)
# Key captured from the Rollo iOS app. Authorizes legacy Places
# Autocomplete + Place Details + Text Search via the
# `X-Ios-Bundle-Identifier: com.rollo.app` header pinned in the adapter.
# Default geocoder for tracking-event coordinate resolution — keeps
# Google quota free. Rotates rarely (tracks Rollo iOS build cycle);
# recapture if requests start failing with REQUEST_DENIED.
ROLLO_API_KEY=

PACKAGE_TRACKER_CREDENTIAL=
