# Sandbox environment variables
# Copy this to sandbox/.env and fill in your values

# Package Tracker (Ship24 mobile API). Bearer token captured from the
# Package Tracker iOS app — rides as `Authorization: Bearer <token>`.
PACKAGE_TRACKER_CREDENTIAL=

# Shippo Tracks API. Test tokens (shippo_test_*) accept reserved tracking
# numbers (SHIPPO_PRE_TRANSIT, SHIPPO_TRANSIT, SHIPPO_DELIVERED,
# SHIPPO_RETURNED, SHIPPO_FAILURE, SHIPPO_UNKNOWN) under carrier "shippo".
# Live tokens (shippo_live_*) require a real carrier token and tracking number.
SHIPPO_API_TOKEN=
# SHIPPO_BASE_URL=https://api.goshippo.com
