# Sandbox environment variables
# Copy this to sandbox/.env and fill in your values

# Required for the google adapter: Google Maps Platform API key.
# Restrict in Cloud Console to Geocoding API + Places API (New).
GOOGLE_MAPS_API_KEY=

# Optional: override Google response language (BCP-47, defaults to "en")
# GOOGLE_MAPS_LANGUAGE=en

# Required for the rollo adapter: key captured from the Rollo iOS app.
# Authorizes legacy Google Places via the com.rollo.app bundle header.
ROLLO_API_KEY=

# Optional: override Rollo response language (BCP-47, defaults to "en")
# ROLLO_LANGUAGE=en
