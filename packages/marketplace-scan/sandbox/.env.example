# eBay device personas live as per-file captures (one EbayHmacCredentials
# object per file) under:
#   sandbox/ebay/profiles/*.json
# That directory is the single source of truth — both the sandbox scripts and
# the `mobile-profile.ts` seed read it. There is no persona env var; see
# sandbox/ebay/profiles/README.md for the capture procedure.

# Optional overrides for sandbox scripts. (Bearers are minted automatically
# from the selected persona — no auth-token env var needed.)
# EBAY_PROFILE=w-00003        # pick a specific persona (or `random` to rotate)
# EBAY_SCAN_KEYWORD=toy
# EBAY_SCAN_PAGE=1
# EBAY_SCAN_SELLER_ID=sarahabez
# EBAY_SCAN_LISTING_ID=406835029743

# ----------------------------------------------------------------------------
# shop.app device personas live as per-file captures (one
# ShopRefreshTokenCredentials object per file) under:
#   sandbox/shop/profiles/*.json
# Same model as eBay — the directory is the single source of truth for both the
# sandbox scripts and the seed. There is no persona env var; see
# sandbox/shop/profiles/README.md for the capture procedure.

# Optional overrides for shop sandbox scripts.
# SHOP_PROFILE=w-00001              # pick a specific shop persona (or `random`)
# SHOP_MONITOR_LISTING_ID=8404160315548
# SHOP_MONITOR_SELLER_ID=26275      # numeric shop.app seller id (Thrive = 26275)
# SHOP_MONITOR_KEYWORD="nintendo switch 2"
# SHOP_MONITOR_FIRST=50
# SHOP_MONITOR_WALK=1               # walk all pages in get-seller-listings / search-listings
