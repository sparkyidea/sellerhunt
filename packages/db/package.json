{
  "name": "@dashseller/db",
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./*": {
      "default": "./src/*.ts"
    },
    "./schema": {
      "default": "./src/schema/index.ts"
    }
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "db:migrate": "drizzle-kit migrate",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@dashseller/env": "workspace:*",
    "dotenv": "catalog:",
    "drizzle-orm": "catalog:",
    "pg": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@dashseller/config": "workspace:*",
    "@types/papaparse": "catalog:",
    "@types/pg": "catalog:",
    "drizzle-dbml-generator": "catalog:",
    "drizzle-kit": "catalog:",
    "jose": "catalog:",
    "papaparse": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
