table scan_listing_snapshot {
  id text [pk, not null]
  listing_id text [not null]
  scanned_at timestamp [not null, default: `now()`]
  price integer
  item_sold integer
  sold_last_24h integer
  sold_last_30_days integer

  indexes {
    (listing_id, scanned_at) [name: 'scan_listing_snapshot_listing_id_scanned_at_idx']
  }
}

table scan_listing_variant {
  id text [pk, not null]
  listing_id text [not null]
  reference text [not null]
  attributes jsonb
  image_urls text[]
  price integer
  last_scanned_at timestamp
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    (listing_id, reference) [name: 'scan_listing_variant_listing_id_reference_unique', unique]
    listing_id [name: 'scan_listing_variant_listing_id_idx']
    last_scanned_at [name: 'scan_listing_variant_last_scanned_at_idx']
  }
}

table scan_seller {
  id text [pk, not null]
  marketplace text [not null]
  reference text [not null]
  display_name text
  logo_url text
  feedback_score integer
  feedback_percent "numeric(5, 4)"
  total_items_sold integer
  monitored boolean [not null, default: false]
  last_scanned_at timestamp
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    (marketplace, reference) [name: 'scan_seller_marketplace_reference_unique', unique]
    feedback_score [name: 'scan_seller_feedback_score_idx']
    last_scanned_at [name: 'scan_seller_last_scanned_at_idx']
    (marketplace, last_scanned_at) [name: 'scan_seller_marketplace_last_scanned_at_idx']
  }
}

table session {
  id text [pk, not null]
  expires_at timestamp [not null]
  token text [not null, unique]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null]
  ip_address text
  user_agent text
  user_id text [not null]
  impersonated_by text
  active_organization_id text

  indexes {
    user_id [name: 'session_userId_idx']
  }
}

table setting {
  id text [pk, not null]
  unit_of_measurement measurement_unit
  unit_of_weight weight_unit
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

table shipment {
  id text [pk, not null]
  organization_id text [not null]
  created_by_user_id text
  order_id text
  ship_from_name text
  ship_from_company text
  ship_from_email text
  ship_from_phone text
  ship_from_address_1 text
  ship_from_address_2 text
  ship_from_city text
  ship_from_state text
  ship_from_zipcode text
  ship_from_country text
  ship_from_latitude "double precision"
  ship_from_longitude "double precision"
  ship_to_name text
  ship_to_company text
  ship_to_email text
  ship_to_phone text
  ship_to_address_1 text
  ship_to_address_2 text
  ship_to_city text
  ship_to_state text
  ship_to_zipcode text
  ship_to_country text
  ship_to_latitude "double precision"
  ship_to_longitude "double precision"
  reference text
  carrier text
  method text
  tracking text
  warehouse_id text
  shipping_cost integer
  package_preset_id text
  weight numeric
  package_name text
  package_length numeric
  package_width numeric
  package_height numeric
  provider text
  provider_shipment_id text
  provider_transaction_id text
  provider_rate_id text
  label_status label_status
  label_purchased_at timestamp
  label_url text
  pick_list_url text
  manifest_id text
  shipped_at timestamp
  source text [not null, default: 'local']
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    organization_id [name: 'shipment_organization_id_idx']
    (order_id, reference) [name: 'shipment_order_reference_idx', unique]
  }
}

table shipment_line {
  id text [pk, not null]
  organization_id text [not null]
  shipment_id text [not null]
  order_line_id text [not null]
  quantity integer [not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    (shipment_id, order_line_id) [name: 'shipment_line_shipment_order_line_unique', unique]
    order_line_id [name: 'shipment_line_order_line_id_idx']
    organization_id [name: 'shipment_line_organization_id_idx']
  }
}

table state {
  id text [pk, not null]
  country_id text [not null]
  code text [not null]
  name text [not null]
  latitude "double precision" [not null]
  longitude "double precision" [not null]

  indexes {
    (country_id, code) [name: 'state_country_code_unique', unique]
  }
}

table stock {
  id text [pk, not null]
  organization_id text [not null]
  warehouse_id text [not null]
  product_variant_id text [not null]
  quantity integer [not null, default: 0]
  reserved_quantity integer [not null, default: 0]
  seed_basis text
  seed_observed_at timestamp
  seed_observed_upper_at timestamp
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    organization_id [name: 'stock_organization_id_idx']
    warehouse_id [name: 'stock_warehouse_id_idx']
    (product_variant_id, warehouse_id) [name: 'stock_product_variant_warehouse_unique', unique]
  }
}

table stock_transaction {
  id text [pk, not null]
  organization_id text [not null]
  created_by_user_id text
  stock_id text [not null]
  order_line_id text
  type transaction_type [not null]
  quantity integer [not null]
  note text
  effect_ref text
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    organization_id [name: 'stock_transaction_organization_id_idx']
    stock_id [name: 'stock_transaction_stock_id_idx']
    order_line_id [name: 'stock_transaction_order_line_id_idx']
    type [name: 'stock_transaction_type_idx']
    created_at [name: 'stock_transaction_created_at_idx']
  }
}

table sync_outbox {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  organization_id text [not null]
  channel_id text [not null]
  entity_type text [not null]
  entity_id uuid [not null]
  action text [not null]
  payload jsonb [not null]
  source_id uuid
  status text [not null, default: 'pending']
  error text
  attempts integer [not null, default: 0]
  claimed_by_job text
  claim_generation integer [not null, default: 0]
  external_ref text
  correlation_method text
  remote_snapshot jsonb
  reconciled_at timestamp
  idempotency_key text
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  pushed_at timestamp
  confirmed_at timestamp

  indexes {
    organization_id [name: 'sync_outbox_organization_id_idx']
    (entity_type, entity_id) [name: 'sync_outbox_entity_blocker_idx', unique]
    (entity_type, entity_id, status) [name: 'sync_outbox_in_flight_idx']
    (status, updated_at) [name: 'sync_outbox_status_updated_at_idx']
  }
}

table tax_rate {
  id text [pk, not null]
  zip_id text [not null]
  rate "numeric(8, 6)" [not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    zip_id [name: 'tax_rate_zip_unique', unique]
  }
}

table tracking {
  id text [pk, not null]
  organization_id text [not null]
  shipment_id text [not null]
  provider text [not null]
  tracking_number text [not null]
  service_level_token text
  service_level_name text
  metadata text
  original_eta timestamp
  eta timestamp
  status tracking_status [not null, default: 'unknown']
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    (organization_id, tracking_number) [name: 'tracking_organization_number_idx', unique]
    shipment_id [name: 'tracking_shipment_id_idx']
    status [name: 'tracking_status_idx']
  }
}

table tracking_event {
  id text [pk, not null]
  organization_id text [not null]
  tracking_id text [not null]
  reference text [not null]
  status tracking_status [not null]
  substatus tracking_substatus
  status_details text
  status_date timestamp [not null]
  location_city text
  location_state text
  location_zip text
  location_country text
  location text
  latitude "double precision"
  longitude "double precision"
  created_at timestamp [not null, default: `now()`]

  indexes {
    (tracking_id, reference) [name: 'tracking_event_tracking_reference_idx', unique]
    status_date [name: 'tracking_event_status_date_idx']
  }
}

table user {
  id text [pk, not null]
  name text [not null]
  email text [not null, unique]
  email_verified boolean [not null, default: false]
  image text
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  role text
  banned boolean [default: false]
  ban_reason text
  ban_expires timestamp
}

table verification {
  id text [pk, not null]
  identifier text [not null]
  value text [not null]
  expires_at timestamp [not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    identifier [name: 'verification_identifier_idx']
  }
}

table warehouse {
  id text [pk, not null]
  organization_id text [not null]
  created_by_user_id text
  address_1 text [not null]
  address_2 text
  city text [not null]
  state text [not null]
  zipcode text [not null]
  country text
  latitude "double precision"
  longitude "double precision"
  archived boolean [not null, default: false]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

table webhook_delivery {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  marketplace text [not null]
  delivery_id text [not null]
  topic text [not null]
  event_type text [not null]
  resource_id text
  channel_id text
  outcome text [not null]
  attempts integer [not null, default: 1]
  payload jsonb
  received_at timestamp [not null, default: `now()`]
  last_seen_at timestamp [not null, default: `now()`]

  indexes {
    (marketplace, delivery_id) [name: 'webhook_delivery_marketplace_delivery_unique', unique]
  }
}

table zip {
  id text [pk, not null]
  city_id text [not null]
  code text [not null]
  latitude "double precision"
  longitude "double precision"

  indexes {
    (city_id, code) [name: 'zip_city_code_unique', unique]
    code [name: 'zip_code_idx']
  }
}

