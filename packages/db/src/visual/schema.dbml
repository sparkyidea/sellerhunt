  last_scanned_at timestamp
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    (marketplace, reference) [name: 'scan_listing_marketplace_reference_unique', unique]
    seller_id [name: 'scan_listing_seller_id_idx']
    item_sold [name: 'scan_listing_item_sold_idx']
    sold_last_24h [name: 'scan_listing_sold_last_24h_idx']
