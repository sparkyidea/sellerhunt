enum inspection_outcome {
  new
  open_box
  used
  damaged
  defective
  missing_items
  wrong_item_returned
}

enum issue_resolution {
  refunded
  replaced
  repaired
  denied
  credited
  cancelled
}

enum issue_status {
  open
  under_review
  approved
  rejected
  resolved
  escalated
}

enum issue_type {
  cancellation
  return
  refund
  replacement
  warranty
  claim
}

enum label_status {
  waiting
  queued
  success
  error
  refunded
  refund_pending
  refund_rejected
}

enum listing_status {
  active
  inactive
  out_of_stock
  draft
  sold
  ended
}

enum mobile_profile_status {
  active
  dead
}

enum order_event_type {
  comment
  tracking
  system
}

enum order_line_status {
  pending
  unfulfilled
  partially_fulfilled
  fulfilled
  completed
  canceled
  returned
  refunded
}

enum order_status {
  pending
  unfulfilled
  partially_fulfilled
  fulfilled
  completed
  canceled
  returned
  refunded
}

enum measurement_unit {
  cm
  m
  mm
  in
  ft_in
}

enum weight_unit {
  kg
  g
  lbs
  lbs_oz
}

enum sync_domain {
  orders
  listings
  shipments
  tracking
  channels
}

enum tracking_status {
  pre_transit
  transit
  delivered
  returned
  failure
  unknown
}

enum tracking_substatus {
  information_received
  address_issue
  contact_carrier
  delayed
  delivery_attempted
  delivery_rescheduled
  delivery_scheduled
  location_inaccessible
  notice_left
  out_for_delivery
  package_accepted
  package_arrived
  package_damaged
  package_departed
  package_forwarded
  package_held
  package_processed
  package_processing
  pickup_available
  reschedule_delivery
  delivered
  return_to_sender
  package_unclaimed
  package_undeliverable
  package_disposed
  package_lost
  other
}

enum transaction_type {
  receive
  reserve
  fulfill
  release
  adjust
  return
}

table account {
  id text [pk, not null]
  account_id text [not null]
  provider_id text [not null]
  user_id text [not null]
  access_token text
  refresh_token text
  id_token text
  access_token_expires_at timestamp
  refresh_token_expires_at timestamp
  scope text
  password text
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null]

  indexes {
    user_id [name: 'account_userId_idx']
  }
}

table category {
  id text [pk, not null]
  parent_id text
  name text [not null]
  full_name text [not null]
  level integer [not null]
  leaf boolean [not null, default: false]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

table channel {
  id text [pk, not null]
  organization_id text [not null]
  created_by_user_id text
  marketplace_id text [not null]
  country_id text
  reference text [not null]
  display_name text [not null]
  connected boolean
  connected_at timestamp
  connection_generation uuid [not null, default: `gen_random_uuid()`]
  enabled boolean [not null, default: true]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  archived boolean [not null, default: false]

  indexes {
    organization_id [name: 'channel_organization_id_idx']
    marketplace_id [name: 'channel_marketplace_id_idx']
    archived [name: 'channel_archived_idx']
    (marketplace_id, reference) [name: 'channel_marketplace_reference_unique', unique]
  }
}

table channel_sync_state {
  id text [pk, not null]
  organization_id text [not null]
  channel_id text [not null]
  domain sync_domain [not null]
  status text
  error text
  synced_at timestamp
  last_run_at timestamp
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    (channel_id, domain) [name: 'channel_sync_state_channel_domain_unique', unique]
    organization_id [name: 'channel_sync_state_organization_id_idx']
    (domain, synced_at) [name: 'channel_sync_state_domain_synced_at_idx']
  }
}

table channel_token {
  id text [pk, not null]
  channel_id text [not null, unique]
  access_token text [not null]
  refresh_token text [not null]
  access_token_expires_at timestamp [not null]
  refresh_token_expires_at timestamp [not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

table channel_webhook_subscription {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  channel_id text [not null]
  topic text [not null]
  subscription_id text [not null]
  destination_id text
  status text [not null, default: 'enabled']
  error text
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    (channel_id, topic) [name: 'channel_webhook_subscription_channel_topic_unique', unique]
  }
}

table city {
  id text [pk, not null]
  country_id text [not null]
  state_id text
  name text [not null]
  latitude "double precision"
  longitude "double precision"

  indexes {
    (country_id, state_id, name) [name: 'city_country_state_name_unique', unique]
    (country_id, state_id) [name: 'city_country_state_idx']
    name [name: 'city_name_idx']
  }
}

table country {
  id text [pk, not null]
  name text [not null]
  code text [not null]
  emoji text [not null]
  emoji_unicode text [not null]
  currency text [not null]
  currency_code text [not null]
  latitude "double precision"
  longitude "double precision"

  indexes {
    code [name: 'country_code_unique', unique]
  }
}

table invitation {
  id text [pk, not null]
  organization_id text [not null]
  email text [not null]
  role text
  status text [not null, default: 'pending']
  expires_at timestamp [not null]
  created_at timestamp [not null, default: `now()`]
  inviter_id text [not null]

  indexes {
    organization_id [name: 'invitation_organizationId_idx']
    email [name: 'invitation_email_idx']
  }
}

table issue {
  id text [pk, not null]
  organization_id text [not null]
  created_by_user_id text
  channel_id text
  order_id text [not null]
  order_line_id text
  reference text
  type issue_type [not null]
  status issue_status [not null, default: 'open']
  resolution issue_resolution
  reason text
  reason_code text
  customer_note text
  seller_note text
  refund_amount integer
  opened_at timestamp [not null, default: `now()`]
  resolved_at timestamp
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    (order_id, type) [name: 'issue_order_id_type_unique', unique]
    organization_id [name: 'issue_organization_id_idx']
    channel_id [name: 'issue_channel_id_idx']
    order_id [name: 'issue_order_id_idx']
    type [name: 'issue_type_idx']
    status [name: 'issue_status_idx']
    reference [name: 'issue_reference_idx']
  }
}

table listing {
  id text [pk, not null]
  organization_id text [not null]
  created_by_user_id text
  product_id text
  channel_id text
  marketplace_category_id text
  reference text
  title text [not null]
  sub_title text
  description text
  description_html text
  type text [not null]
  url text [not null]
  brand text
  manufacturer text
  condition text [not null]
  condition_note text
  image_urls text[]
  watch_count integer
  view_count integer
  duration text
  status listing_status [not null]
  variant boolean [not null, default: false]
  offer boolean [default: false]
  offer_accept_price integer
  offer_decline_price integer
  domestic_return boolean [not null, default: false]
  domestic_return_window integer
  domestic_return_paid_by text
  international_return boolean [not null, default: false]
  international_return_window integer
  international_return_paid_by text
  restocking_fee integer
  local_pickup boolean [not null, default: false]
  handling_time integer [not null]
  handling_fee integer
  domestic_shipping boolean [not null, default: false]
  domestic_shipping_type text
  domestic_shipping_base_fee integer
  domestic_shipping_additional_fee integer
  international_shipping boolean [not null, default: false]
  international_shipping_type text
  international_shipping_base_fee integer
  international_shipping_additional_fee integer
  started_at timestamp [not null]
  ended_at timestamp
  synced_at timestamp
  sync_status text
  sync_error text
  source_version_at timestamp
  last_observed_at timestamp
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  archived boolean [not null, default: false]
  archived_at timestamp
  search tsvector

  indexes {
    (organization_id, channel_id, reference) [name: 'listing_organization_id_channel_id_reference_unique', unique]
    organization_id [name: 'listing_organization_id_idx']
    product_id [name: 'listing_product_id_idx']
    channel_id [name: 'listing_channel_id_idx']
    reference [name: 'listing_reference_idx']
    status [name: 'listing_status_idx']
    created_at [name: 'listing_created_at_idx']
    search [name: 'listing_search_idx']
    marketplace_category_id [name: 'listing_marketplace_category_id_idx']
  }
}

table listing_variant {
  id text [pk, not null]
  organization_id text [not null]
  listing_id text [not null]
  product_variant_id text
  reference text [not null]
  sku text
  model text
  upc text
  ean text
  isbn text
  gtin text
  attributes jsonb
  price integer [not null]
  quantity integer [not null]
  sold integer [not null, default: 0]
  length integer [not null]
  width integer [not null]
  height integer [not null]
