enum mobile_profile_status {
  active
  dead
}

table account {
  id text [pk, not null]
  account_id text [not null]
  issuer text [not null]
  provider_id text [not null]
  user_id text [not null]
  access_token text
  refresh_token text
  id_token text
  access_token_expires_at timestamp
  refresh_token_expires_at timestamp
  scope text
  password text
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null]

  indexes {
    user_id [name: 'account_userId_idx']
    (issuer, account_id) [name: 'account_issuer_accountId_uidx', unique]
  }
}

table mobile_profile {
  id text [pk, not null]
  app text [not null]
  label text
  credentials text [not null]
  access_token text
  access_token_expires_at timestamp
  refresh_token text
  refresh_token_expires_at timestamp
  status mobile_profile_status [not null, default: 'active']
  last_used_at timestamp
  last_success_at timestamp
  failed_at timestamp
  failure_reason text
  failure_count integer [not null, default: 0]
  cooldown_until timestamp
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    (app, status) [name: 'mobile_profile_app_status_idx']
    last_used_at [name: 'mobile_profile_last_used_at_idx']
    cooldown_until [name: 'mobile_profile_cooldown_until_idx']
  }
}

table passkey {
  id text [pk, not null]
  name text
  public_key text [not null]
  user_id text [not null]
  credential_id text [not null]
  counter integer [not null]
  device_type text [not null]
  backed_up boolean [not null]
  transports text
  created_at timestamp [not null, default: `now()`]
  aaguid text

  indexes {
    user_id [name: 'passkey_userId_idx']
    credential_id [name: 'passkey_credentialID_idx']
  }
}

table scan_config {
  marketplace text [pk, not null]
  enabled boolean [not null, default: true]
  max_search_pages integer [not null, default: 10]
  min_item_sold integer [not null, default: 0]
  min_price_cents integer [not null, default: 0]
  max_price_cents integer
  min_sold_last_24h integer
  keyword_batch_size integer [not null, default: 20]
  seller_batch_size integer [not null, default: 20]
  listing_batch_size integer [not null, default: 50]
  listing_scan_batch_size integer [not null, default: 50]
  listing_scan_delay_min_ms integer [not null, default: 200]
  listing_scan_delay_max_ms integer [not null, default: 800]
  keyword_llm_enabled boolean [not null, default: true]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

table scan_keyword {
  id text [pk, not null, default: `gen_random_uuid()`]
  marketplace text [not null]
  keyword text [not null]
  source text [not null]
  first_seen_at timestamp [not null, default: `now()`]
  last_seen_at timestamp [not null, default: `now()`]
  last_scanned_at timestamp
  dead_at timestamp
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    (marketplace, keyword) [name: 'scan_keyword_marketplace_keyword_unique', unique]
    (marketplace, last_scanned_at) [name: 'scan_keyword_marketplace_last_scanned_at_idx']
  }
}

table scan_listing {
  id text [pk, not null]
  marketplace text [not null]
  reference text [not null]
  seller_id text
  keyword_id text
  keyword_attempts integer [not null, default: 0]
  title text [not null]
  description text
  condition text
  marketplace_category_reference text
  category_path text[]
  image_urls text[]
  url text
  variant boolean [not null, default: false]
  good_till_cancelled boolean
  started_at timestamp
  ended_at timestamp
  price integer
  currency text
  item_sold integer
  sold_last_24h integer
  sold_last_30_days integer
  monitored boolean [not null, default: false]
  last_scanned_at timestamp
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    (marketplace, reference) [name: 'scan_listing_marketplace_reference_unique', unique]
    seller_id [name: 'scan_listing_seller_id_idx']
    keyword_id [name: 'scan_listing_keyword_id_idx']
    item_sold [name: 'scan_listing_item_sold_idx']
    sold_last_24h [name: 'scan_listing_sold_last_24h_idx']
    sold_last_30_days [name: 'scan_listing_sold_last_30_days_idx']
    last_scanned_at [name: 'scan_listing_last_scanned_at_idx']
    marketplace_category_reference [name: 'scan_listing_marketplace_category_reference_idx']
    (marketplace, last_scanned_at) [name: 'scan_listing_marketplace_last_scanned_at_idx']
  }
}

table scan_listing_snapshot {
  id text [pk, not null]
  listing_id text [not null]
  scanned_at timestamp [not null, default: `now()`]
  price integer
  item_sold integer
  sold_last_24h integer
  sold_last_30_days integer

  indexes {
    (listing_id, scanned_at) [name: 'scan_listing_snapshot_listing_id_scanned_at_idx']
  }
}

table scan_listing_variant {
  id text [pk, not null]
  listing_id text [not null]
  reference text [not null]
  attributes jsonb
  image_urls text[]
  price integer
  last_scanned_at timestamp
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    (listing_id, reference) [name: 'scan_listing_variant_listing_id_reference_unique', unique]
    listing_id [name: 'scan_listing_variant_listing_id_idx']
    last_scanned_at [name: 'scan_listing_variant_last_scanned_at_idx']
  }
}

table scan_seller {
  id text [pk, not null]
  marketplace text [not null]
  reference text [not null]
  display_name text
  logo_url text
  feedback_score integer
  feedback_percent "numeric(5, 4)"
  total_items_sold integer
  monitored boolean [not null, default: false]
  last_scanned_at timestamp
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    (marketplace, reference) [name: 'scan_seller_marketplace_reference_unique', unique]
    feedback_score [name: 'scan_seller_feedback_score_idx']
    last_scanned_at [name: 'scan_seller_last_scanned_at_idx']
    (marketplace, last_scanned_at) [name: 'scan_seller_marketplace_last_scanned_at_idx']
  }
}

table session {
  id text [pk, not null]
  expires_at timestamp [not null]
  token text [not null, unique]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null]
  ip_address text
  user_agent text
  user_id text [not null]
  impersonated_by text

  indexes {
    user_id [name: 'session_userId_idx']
  }
}

table two_factor {
  id text [pk, not null]
  secret text [not null]
  backup_codes text [not null]
  user_id text [not null]
  verified boolean [default: true]
  failed_verification_count integer [default: 0]
  locked_until timestamp

  indexes {
    secret [name: 'two_factor_secret_idx']
    user_id [name: 'two_factor_userId_idx']
  }
}

table user {
  id text [pk, not null]
  name text [not null]
  email text [not null, unique]
  email_verified boolean [not null, default: false]
  image text
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  role text
  banned boolean [default: false]
  ban_reason text
  ban_expires timestamp
  two_factor_enabled boolean [default: false]
}

table verification {
  id text [pk, not null]
  identifier text [not null]
  value text [not null]
  expires_at timestamp [not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    identifier [name: 'verification_identifier_idx']
  }
}

ref account_user_id_user_id_fk: account.user_id > user.id [delete: cascade, update: no action]

ref passkey_user_id_user_id_fk: passkey.user_id > user.id [delete: cascade, update: no action]

ref scan_listing_seller_id_scan_seller_id_fk: scan_listing.seller_id > scan_seller.id [delete: set null, update: no action]

ref scan_listing_keyword_id_scan_keyword_id_fk: scan_listing.keyword_id > scan_keyword.id [delete: set null, update: no action]

ref scan_listing_snapshot_listing_id_scan_listing_id_fk: scan_listing_snapshot.listing_id > scan_listing.id [delete: cascade, update: no action]

ref scan_listing_variant_listing_id_scan_listing_id_fk: scan_listing_variant.listing_id > scan_listing.id [delete: cascade, update: no action]

ref session_user_id_user_id_fk: session.user_id > user.id [delete: cascade, update: no action]

ref two_factor_user_id_user_id_fk: two_factor.user_id > user.id [delete: cascade, update: no action]