    listing_id [name: 'listing_variant_listing_id_idx']
    product_variant_id [name: 'listing_variant_product_variant_id_idx']
    sku [name: 'listing_variant_sku_idx']
    reference [name: 'listing_variant_reference_idx']
  }
}

table marketplace {
  id text [pk, not null]
  name text [not null]
  logo_url text
  enabled boolean [not null, default: true]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  archived boolean [not null, default: false]
}

table marketplace_category {
  id text [pk, not null]
  marketplace_id text [not null]
  site_id text
  reference text [not null]
  category_id text
  name text [not null]
  full_name text
  parent_reference text
  leaf boolean [not null, default: false]
  mapping_confidence real
  mapping_source text
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    (marketplace_id, site_id, reference) [name: 'mc_marketplace_site_reference_unique', unique]
    marketplace_id [name: 'mc_marketplace_id_idx']
    category_id [name: 'mc_category_id_idx']
  }
}

table member {
  id text [pk, not null]
  organization_id text [not null]
  user_id text [not null]
  role text [not null, default: 'member']
  created_at timestamp [not null]

  indexes {
    organization_id [name: 'member_organizationId_idx']
    user_id [name: 'member_userId_idx']
  }
}

table mobile_profile {
  id text [pk, not null]
  app text [not null]
  label text
  credentials text [not null]
  access_token text
  access_token_expires_at timestamp
  refresh_token text
  refresh_token_expires_at timestamp
  status mobile_profile_status [not null, default: 'active']
  last_used_at timestamp
  last_success_at timestamp
  failed_at timestamp
  failure_reason text
  failure_count integer [not null, default: 0]
  cooldown_until timestamp
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    (app, status) [name: 'mobile_profile_app_status_idx']
    last_used_at [name: 'mobile_profile_last_used_at_idx']
    cooldown_until [name: 'mobile_profile_cooldown_until_idx']
  }
}

table order {
  id text [pk, not null]
  organization_id text [not null]
  created_by_user_id text
  channel_id text
  reference text
  order_number text
  customer_username text
  billing_name text
  billing_company text
  billing_email text
  billing_phone text
  billing_address_1 text
  billing_address_2 text
  billing_city text
  billing_state text
  billing_zip_code text
  billing_country text
  subtotal integer
  shipping_cost integer
  discount integer
  tax integer
  total integer
  currency text [not null, default: 'USD']
  shipping_name text
  shipping_company text
  shipping_email text
  shipping_phone text
  shipping_address_1 text
  shipping_address_2 text
  shipping_city text
  shipping_state text
  shipping_zip_code text
  shipping_country text
  ordered_at timestamp
  status order_status
  status_date timestamp
  fulfillment_status text
  fulfillment_strategy text
  multi_warehouse boolean [not null, default: false]
  auto_fulfill boolean [not null, default: false]
  fulfillment_hold_reason text
  refund integer
  payment_method text
  paid_at timestamp
  ship_by timestamp
  shipped_at timestamp
  requested_shipping_carrier text
  requested_shipping_method text
  customer_note text
  seller_note text
  deliver_by timestamp
  delivered_at timestamp
  source_version_at timestamp
  remote_missing_at timestamp
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  archived boolean [not null, default: false]
  parent_order_id text
  search tsvector

  indexes {
    (organization_id, channel_id, reference) [name: 'order_organization_id_channel_id_reference_unique', unique]
    organization_id [name: 'order_organization_id_idx']
    order_number [name: 'order_number_idx']
    channel_id [name: 'order_channel_id_idx']
    ordered_at [name: 'order_ordered_at_idx']
    status [name: 'order_status_idx']
    archived [name: 'order_archived_idx']
    parent_order_id [name: 'order_parent_order_id_idx']
    search [name: 'order_search_idx']
  }
}

