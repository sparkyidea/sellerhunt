  title text [not null]
  description text
  condition text
  marketplace_category_reference text
  category_path text[]
  image_urls text[]
  url text
  variant boolean [not null, default: false]
  good_till_cancelled boolean
  started_at timestamp
  ended_at timestamp
  price integer
  currency text
  item_sold integer
  sold_last_24h integer
  sold_last_30_days integer
