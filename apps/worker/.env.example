# apps/worker — BullMQ marketplace-sync worker + public webhook receiver.
# Schema: packages/env/src/worker.ts — every var here fails boot if missing.

# Database — local docker services (bun docker:up). Seed with
# `bun db:clone` (prompts for the remote URL) or `bun db:migrate`.
DATABASE_URL=postgresql://dashseller:dashseller@localhost:54320/dashseller

# Job queue (BullMQ consumer). Same Redis the API produces into.
# Production Redis must run maxmemory-policy=noeviction with AOF
# persistence — eviction silently drops jobs. On Dokploy this is the
# internal service hostname on the shared Docker network.
# Local dev: docker-compose.dev.yml exposes redis on 63790
# (bun docker:up).
REDIS_QUEUE_URL=redis://localhost:63790

# Public base URL of THIS worker. Marketplaces deliver webhooks to
# `${WEBHOOK_BASE_URL}/webhook/{marketplaceId}`; the eBay challenge hash
# and subscription reconciliation are computed over it, so it must
# byte-match the API's WEBHOOK_BASE_URL and what marketplaces have
# registered.
WEBHOOK_BASE_URL=http://localhost:8788

# eBay Notification API shared secret. The API registers it at connect
# time; this worker answers challenges with the same value. Any 32-80
# char random string; must match the API's copy.
EBAY_WEBHOOK_VERIFICATION_TOKEN=

# Gate for upsertJobScheduler registration. Deploy with false; flip to
# true at the cutover step (CUTOVER.md §4) and restart. Replica-safe.
SYNC_SCHEDULERS_ENABLED=false

# Health/readiness HTTP port (default 8788).
# PORT=8788

# Must match the API's copy — channel credentials are encrypted at
# connect time (API) and decrypted at sync time (this worker).
ENCRYPTION_SECRET=your-encryption-secret-at-least-32-characters-long

# Marketplace: eBay
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_RU_NAME=

# Marketplace: Shopify
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Geo: Google Maps Platform
# Single key authorizes Geocoding API + Places API (New). Restrict in
# Cloud Console to those APIs and this deployment's egress IPs.
GOOGLE_MAPS_API_KEY=

# Geo: Rollo (legacy Google Places via Rollo's iOS app credentials).
# Default geocoder — keeps Google quota free. Rotates with Rollo iOS
# builds; recapture on REQUEST_DENIED.
ROLLO_API_KEY=
