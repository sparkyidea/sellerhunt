    "@dashseller/db": "workspace:*",
    "@dashseller/env": "workspace:*",
    "drizzle-orm": "catalog:",
    "jose": "catalog:",
    "@hono/trpc-server": "catalog:",
    "@trpc/server": "catalog:",
    "better-auth": "catalog:",
    "hono": "catalog:",
    "zod": "catalog:",
    "@dashseller/job-client": "workspace:*",
    "@dashseller/sync": "workspace:*",
    "@dashseller/geo": "workspace:*"
  },
  "devDependencies": {
    "@dashseller/config": "workspace:*",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  }
