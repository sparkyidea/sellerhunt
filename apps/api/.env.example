# Database — local docker services (bun docker:up). drizzle-kit
# reads this file too, so db:generate/migrate/studio follow it.
# Seed with `bun db:clone` (prompts for the remote dev DB URL) or start
# empty with `bun db:migrate`.
DATABASE_URL=postgresql://dashseller:dashseller@localhost:54320/dashseller

# Better Auth
BETTER_AUTH_SECRET=your-secret-key-at-least-32-characters-long

# OAuth - Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth - Discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=noreply@yourdomain.com

# URLs
APP_URL=http://localhost:3002
API_URL=http://localhost:3000

# Optional: Cookie domain for cross-subdomain auth
# COOKIE_DOMAIN=

# Encryption key for the scan persona pool (mobile_profile credentials/bearers).
# Read by the `mobile-profile` DB seed and by the scan worker
# (packages/trigger-scan, which validates its own copy). Any 32+ char string.
ENCRYPTION_SECRET=your-encryption-secret-at-least-32-characters-long
