# Database — local docker services (bun docker:up). drizzle-kit
# reads this file too, so db:generate/migrate/studio follow it.
# Seed with `bun db:clone` (prompts for the remote dev DB URL) or start
# empty with `bun db:migrate`.
DATABASE_URL=postgresql://dashseller:dashseller@localhost:54320/dashseller

# Better Auth
BETTER_AUTH_SECRET=your-secret-key-at-least-32-characters-long

# OAuth - Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth - Discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=noreply@yourdomain.com

# URLs
APP_URL=http://localhost:3002
API_URL=http://localhost:3000

# Job queue (BullMQ producer — tRPC context).
# Point at the same Redis the worker consumes. Production Redis must run
# with maxmemory-policy=noeviction and AOF persistence — eviction silently
# drops jobs. Local dev: docker-compose.dev.yml exposes redis on 63790
# (bun docker:up).
REDIS_QUEUE_URL=redis://localhost:63790

# Public base URL of apps/worker — the webhook RECEIVER lives there, not
# on this API. OAuth-connect registers subscription endpoints as
# `${WEBHOOK_BASE_URL}/webhook/{marketplaceId}`. Must match the worker's
# own WEBHOOK_BASE_URL byte for byte.
WEBHOOK_BASE_URL=http://localhost:8788

# eBay Notification API shared secret. This API registers it with the
# notification destination at connect time; the WORKER answers challenges
# with the same value. Any 32-80 char random string; must match the
# worker's copy and what eBay has on record.
EBAY_WEBHOOK_VERIFICATION_TOKEN=

# Optional: Cookie domain for cross-subdomain auth
# COOKIE_DOMAIN=

ENCRYPTION_SECRET=your-encryption-secret-at-least-32-characters-long

# Marketplace: eBay
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_RU_NAME=

# Marketplace: Shopify
# Get Client ID + Client Secret from partners.shopify.com → Apps → [your app]
# → Configuration → Client credentials. The redirect URI is derived from
# API_URL as `${API_URL}/oauth/marketplace/shopify/callback` and must be
# registered as an "Allowed redirection URL" in the same Configuration page.
# Scopes are pinned in code (packages/marketplace → shopify/scopes); keep the
# Partner dashboard's access_scopes list in sync.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Media storage: Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public base URL for served objects (no trailing slash), e.g. https://media.example.com
R2_PUBLIC_URL=

# Geo: Google Maps Platform
# Single key authorizes Geocoding API + Places API (New). Restrict in
# Cloud Console to those APIs and to the IPs of this server's deployment.
# Consumed by `shipment.create` tRPC mutation for ship-to geocoding when
# the geocoder factory is configured to use the "google" adapter.
GOOGLE_MAPS_API_KEY=

# Geo: Rollo (legacy Google Places via Rollo's iOS app credentials)
# Key captured from the Rollo iOS app. Authorizes legacy Places
# Autocomplete + Place Details + Text Search via the
# `X-Ios-Bundle-Identifier: com.rollo.app` header pinned in the adapter.
# Default geocoder for `shipment.create` — keeps Google quota free.
# Rotates rarely (tracks Rollo iOS build cycle); recapture if requests
# start failing with REQUEST_DENIED.
ROLLO_API_KEY=
