# Database
DATABASE_URL=

# mobile_profile credential encryption
# Same 32+ char key as the sync worker — used by mobile-profile-manager to
# encrypt/decrypt device credentials and minted bearers on `mobile_profile`.
ENCRYPTION_SECRET=

# OpenAI — keyword extraction (inline in `scan-listings-by-ids`). Read only when
# `scan_config.keyword_llm_enabled = true` (the default). Leave blank and the
# scan still runs; keyword extraction for those new listings is skipped.
OPENAI_API_KEY=
