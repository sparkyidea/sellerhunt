  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration --concurrency=1",
    "test:docker:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "test:docker:down": "docker compose -f docker-compose.test.yml down -v",
    "docker:up": "docker compose -f docker-compose.dev.yml up -d --wait",
    "docker:down": "docker compose -f docker-compose.dev.yml down",
    "db:push": "bun --cwd packages/db drizzle-kit push",
    "db:studio": "bun --cwd packages/db drizzle-kit studio",
    "db:generate": "bun --cwd packages/db drizzle-kit generate",
    "db:migrate": "bun --cwd packages/db drizzle-kit migrate",
    "db:clone": "bash scripts/clone-dev-db.sh",
    "bullmq:studio": "bun --cwd apps/worker bullmq:studio",
    "trigger-sync:dev": "bun --cwd packages/trigger-sync trigger dev --env-file .env",
    "trigger-sync:deploy": "bun --cwd packages/trigger-sync trigger deploy --env-file .env",
    "trigger-scan:dev": "bun --cwd packages/trigger-scan trigger dev --env-file .env --profile sparkyidea -a https://trigger.sparkyidea.com",
    "trigger-scan:deploy": "bun --cwd packages/trigger-scan trigger deploy --env-file .env --profile sparkyidea -a https://trigger.sparkyidea.com",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "prepare": "husky"
  },
  "dependencies": {
    "@dashseller/env": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.7",
    "@dashseller/config": "workspace:*",
    "@types/bun": "1.3.3",
    "husky": "latest",
    "lint-staged": "latest",
    "turbo": "^2.8.12",
    "ultracite": "7.3.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css,scss,md,mdx}": [
      "bun x ultracite fix"
    ]
  },
  "packageManager": "bun@1.3.11"
}
